{
  "name": "crucible-loop",
  "version": "0.2.0",
  "description": "Grounded generate-check-fix loops for AI-agent game content. Grades dialogue and pixel art against named craft knowledge, over MCP or from the command line.",
  "author": "Joshua Kac <joshua@houseofkac.com>",
  "license": "MIT",
  "keywords": [
    "crucible",
    "game-development",
    "ai-agents",
    "mcp",
    "model-context-protocol",
    "claude-code",
    "pixel-art",
    "game-writing",
    "linter"
  ],
  "homepage": "https://github.com/SirStig/Crucible#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SirStig/Crucible.git"
  },
  "bugs": {
    "url": "https://github.com/SirStig/Crucible/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "crucible": "dist/cli/bin.js"
  },
  "files": [
    "dist",
    "data",
    "src"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@resvg/resvg-js": "^2.6.2",
    "commander": "^15.0.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.2",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  }
}
