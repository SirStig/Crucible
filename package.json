{
  "name": "canvasloop",
  "private": true,
  "version": "0.1.0",
  "description": "Grounded generate-check-fix loops for AI-agent-produced game craft. Prose Craft Loop (Track B) v0.1.",
  "author": "Joshua Kac <joshua@houseofkac.com>",
  "license": "MIT",
  "keywords": [
    "canvasloop",
    "game-development",
    "ai-agents",
    "mcp",
    "pixel-art",
    "game-writing"
  ],
  "homepage": "https://github.com/SirStig/CanvasLoop#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SirStig/CanvasLoop.git"
  },
  "bugs": {
    "url": "https://github.com/SirStig/CanvasLoop/issues"
  },
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "npm run clean --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.2",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  }
}
