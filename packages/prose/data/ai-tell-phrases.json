  "templates": [
    {
      "id": "not-just-x-its-y",
      "pattern": "not (?:just|only)\\s+[^,.!?]{1,80},?\\s+(?:it'?s|it is|they'?re|they are|this is|that'?s)\\s+[^,.!?]{1,80}",
      "severity": "warn",
      "minOccurrencesForFail": 2,
      "note": "The canonical AI balanced-contrast construction (\"it's not just X, it's Y\"), independently confirmed across multiple overused-phrase compilations.",
      "source": {
        "name": "Wikipedia:Signs of AI writing",
        "url": "https://en.wikipedia.org/wiki/Wikipedia:Signs_of_AI_writing"
      }
    },
    {
      "id": "more-than-just-x-its-y",
      "pattern": "more than just\\s+[^,.!?]{1,80},?\\s+(?:it'?s|it is|they'?re|this is)\\s+[^,.!?]{1,80}",
      "severity": "warn",
      "minOccurrencesForFail": 2,
      "note": "Variant of the not-just-x-its-y construction."
    },
    {
      "id": "isnt-about-x-its-about-y",
      "pattern": "isn'?t (?:about|just about)\\s+[^,.!?]{1,80},?\\s+(?:it'?s|it is)\\s+about\\s+[^,.!?]{1,80}",
      "severity": "warn",
      "minOccurrencesForFail": 2,
      "note": "\"isn't about X, it's about Y\" contrastive template."
    },
    {
      "id": "not-x-but-y",
      "pattern": "not\\s+[^,.!?]{1,60},?\\s+but\\s+[^,.!?]{1,60}",
      "severity": "info",
      "minOccurrencesForFail": 3,
      "note": "Broad \"not X, but Y\" contrast — a normal rhetorical device on its own, only flagged as fail once it recurs often enough to read as a tic.",
      "source": {
        "name": "Wikipedia:Signs of AI writing",
        "url": "https://en.wikipedia.org/wiki/Wikipedia:Signs_of_AI_writing"
      }
    },
    {
      "id": "trailing-participial-clause",
      "pattern": ",\\s+(?:fostering|underscoring|highlighting|reflecting|emphasizing|ensuring|cultivating|encompassing|contributing to)\\b[^.!?]{1,100}[.!?]",
      "severity": "warn",
      "minOccurrencesForFail": 2,
      "note": "A sentence that caps itself with a dangling present-participle clause (\"..., underscoring its importance.\") — a distinct, documented AI habit from the plain word list above.",
      "source": {
        "name": "Wikipedia:Signs of AI writing",
        "url": "https://en.wikipedia.org/wiki/Wikipedia:Signs_of_AI_writing"
      }
    }
  ]
