{
  "name": "crucible-loop",
  "version": "0.1.0",
  "description": "Command-line interface for Crucible: grade and export prose (Track B) and render/grade pixel-art sprites (Track A). Installs the `crucible` command.",
  "author": "Joshua Kac <joshua@houseofkac.com>",
  "license": "MIT",
  "keywords": [
    "crucible",
    "game-development",
    "ai-agents",
    "mcp",
    "cli",
    "linter"
  ],
  "homepage": "https://github.com/SirStig/Crucible/tree/main/packages/cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SirStig/Crucible.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/SirStig/Crucible/issues"
  },
  "type": "module",
  "bin": {
    "crucible": "dist/bin.js"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "crucible-base": "0.1.0",
    "crucible-prose": "0.1.0",
    "crucible-visual": "0.1.0",
    "commander": "^15.0.0"
  }
}
