{
  "name": "@canvasloop/visual",
  "version": "0.1.0",
  "description": "Track A (Visual Craft Loop) rubric engine: SVG rendering, structural grading, deterministic Tier 1 pixel-art craft detectors (banding, jaggies, dithering overuse, outline inconsistency, too-many-similar-colors, unattached fragments, unintended holes), and a Tier 2 visual-craft rubric library.",
  "author": "Joshua Kac <joshua@houseofkac.com>",
  "license": "MIT",
  "keywords": [
    "canvasloop",
    "game-development",
    "ai-agents",
    "mcp",
    "pixel-art",
    "sprite",
    "svg",
    "game-art"
  ],
  "homepage": "https://github.com/SirStig/CanvasLoop/tree/main/packages/visual#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SirStig/CanvasLoop.git",
    "directory": "packages/visual"
  },
  "bugs": {
    "url": "https://github.com/SirStig/CanvasLoop/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "data",
    "src"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@canvasloop/core": "0.1.0",
    "@resvg/resvg-js": "^2.6.2",
    "zod": "^4.6.2"
  }
}
