{
  "name": "canvasloop-mcp-server",
  "version": "0.1.0",
  "description": "CanvasLoop MCP server: exposes both tracks' tools over stdio, covering Track B prose grading and Track A pixel-art sprite grading.",
  "author": "Joshua Kac <joshua@houseofkac.com>",
  "license": "MIT",
  "keywords": [
    "canvasloop",
    "game-development",
    "ai-agents",
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "claude-code"
  ],
  "homepage": "https://github.com/SirStig/CanvasLoop/tree/main/packages/mcp-server#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SirStig/CanvasLoop.git",
    "directory": "packages/mcp-server"
  },
  "bugs": {
    "url": "https://github.com/SirStig/CanvasLoop/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "canvasloop-mcp-server": "./dist/index.js"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "canvasloop-core": "0.1.0",
    "canvasloop-prose": "0.1.0",
    "canvasloop-visual": "0.1.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.6.2"
  }
}
